APP_ENV=production
APP_PUBLIC_URL=https://dashboard.example.local
BACKEND_VERSION=0.2.1
FRONTEND_VERSION=1.1.1+3
GIT_COMMIT=unknown

POSTGRES_DB=neotelecom
POSTGRES_USER=neotelecom
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://neotelecom:change-me@postgres:5432/neotelecom?sslmode=disable

BACKEND_PORT=8080
STORE_DRIVER=postgres
JWT_SECRET=change-me-long-random-secret
CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-key
ALLOW_INSECURE_TLS=true

BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

FRONTEND_PORT=80
